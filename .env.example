# =============================================================================
# Multi-Agent Code Review & Debugging Pipeline - Environment Configuration
# =============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# IMPORTANT: Never commit '.env' containing real secrets to version control.

# OpenAI or OpenAI-compatible provider API key (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom API base URL (useful for Ollama, vLLM, Azure, OpenRouter, etc.)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier to use for the review agents
# Default: gpt-4o-mini
OPENAI_MODEL_NAME=gpt-4o-mini

# Request timeout in seconds for LLM calls (Default: 30)
LLM_TIMEOUT=30
